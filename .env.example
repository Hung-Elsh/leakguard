# Copy to .env and fill in. .env is git-ignored.
LEAKGUARD_PROFILE=lab            # lab | internet

# Breach / leak sources
HIBP_API_KEY=
INTELX_API_KEY=
INTELX_API_URL=https://free.intelx.io   # free tier host

# Google Programmable Search
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=

# GitHub (optional, raises search rate limits)
GITHUB_TOKEN=

# Gmail OAuth client (downloaded from Google Cloud Console)
GMAIL_CLIENT_SECRET_FILE=~/.config/leakguard/client_secret.json

# Lab mail (GreenMail account on 192.168.1.250)
LAB_IMAP_USER=zorblat11@seclab.test
LAB_IMAP_PASSWORD=
