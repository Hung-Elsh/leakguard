# Optional, for developers. Keys normally go in the system keyring: `leakguard keys set NAME`.
# An environment variable (or this file, copied to the git-ignored .env) wins over the keyring.
LEAKGUARD_PROFILE=lab            # lab | internet

# Breach / leak sources
HIBP_API_KEY=
INTELX_API_KEY=
INTELX_API_URL=https://free.intelx.io   # free tier host

# Brave Search API (web search; api-dashboard.search.brave.com)
BRAVE_API_KEY=

# Google Programmable Search (closed to new projects; source disabled)
GOOGLE_PSE_API_KEY=
GOOGLE_PSE_CX=

# GitHub (optional, raises search rate limits)
GITHUB_TOKEN=

# Gmail OAuth client (downloaded from Google Cloud Console)
GMAIL_CLIENT_SECRET_FILE=~/.config/leakguard/client_secret.json

# Lab mail (GreenMail account on 192.168.1.250)
LAB_IMAP_USER=zorblat11@seclab.test
LAB_IMAP_PASSWORD=
